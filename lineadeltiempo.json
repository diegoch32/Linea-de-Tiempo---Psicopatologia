<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Línea del Tiempo: Psicopatología</title>
    <link title="timeline-theme" rel="stylesheet" href="https://cdn.knightlab.com/libs/timeline3/latest/css/timeline.css">
    <style>
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; }
        #timeline-embed { width: 100%; height: 100vh; }
    </style>
</head>
<body>
    <div id="timeline-embed"></div>
    <script src="https://cdn.knightlab.com/libs/timeline3/latest/js/timeline.js"></script>
    <script>
        var timelineData = {
          "title": {
            "media": {
              "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6a/Goya_-_Casa_de_locos.jpg/800px-Goya_-_Casa_de_locos.jpg"
            },
            "text": {
              "headline": "Historia de la Psicopatología",
              "text": "Una travesía desde las concepciones mágico-religiosas hasta su consolidación científica."
            }
          },
          "events": [
            {
              "start_date": { "year": "-400" },
              "media": { "url": "https://upload.wikimedia.org/wikipedia/commons/3/3a/Hippocrates.jpg" },
              "text": {
                "headline": "Hipócrates y la Teoría de los Humores",
                "text": "Establece la primera aproximación biológica. Rechaza el origen demoníaco de la locura y propone que los trastornos se deben a un desequilibrio de fluidos corporales."
              },
              "group": "Antecedentes"
            },
            {
              "start_date": { "year": "1409" },
              "media": { "url": "https://upload.wikimedia.org/wikipedia/commons/e/e5/Hospital_dels_folls_de_Val%C3%A8ncia.jpg" },
              "text": {
                "headline": "El Primer Hospital Psiquiátrico",
                "text": "Juan Gilabert Jofré funda en Valencia el 'Hospital de los Inocentes'. Considerado el primer centro en Europa dedicado a la asistencia de enfermos mentales."
              },
              "group": "Institucionalización"
            },
            {
              "start_date": { "year": "1563" },
              "media": { "url": "https://upload.wikimedia.org/wikipedia/commons/e/ea/Johann_Weyer.jpg" },
              "text": {
                "headline": "Johann Weyer: Fin de la Demonología",
                "text": "Publica 'De praestigiis daemonum'. Argumenta que las supuestas brujas eran mujeres con trastornos mentales, abogando por un tratamiento médico."
              },
              "group": "Institucionalización"
            },
            {
              "start_date": { "year": "1793" },
              "media": { "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/e/eb/Pinel_a_la_Salpetriere.jpg/800px-Pinel_a_la_Salpetriere.jpg" },
              "text": {
                "headline": "Philippe Pinel y el Tratamiento Moral",
                "text": "Pinel ordena liberar de sus cadenas a los enfermos. Introduce el 'Tratamiento Moral', exigiendo humanismo y observación médica sistemática."
              },
              "group": "Enfoque Clínico"
            },
            {
              "start_date": { "year": "1883" },
              "media": { "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/1/14/Emil_Kraepelin.jpg/800px-Emil_Kraepelin.jpg" },
              "text": {
                "headline": "Emil Kraepelin: La Nosología Moderna",
                "text": "Publica su 'Compendio de Psiquiatría'. Diferenció los trastornos basándose en su curso y desenlace, distinguiendo la esquizofrenia de la psicosis maníaco-depresiva."
              },
              "group": "Enfoque Clínico"
            },
            {
              "start_date": { "year": "1899" },
              "media": { "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/1/12/Sigmund_Freud_LIFE.jpg/800px-Sigmund_Freud_LIFE.jpg" },
              "text": {
                "headline": "Freud y el Inconsciente",
                "text": "Revoluciona la disciplina con el Psicoanálisis. Introduce la idea de que los síntomas psicopatológicos tienen raíces en conflictos inconscientes."
              },
              "group": "Consolidación"
            },
            {
              "start_date": { "year": "1952" },
              "media": { "url": "https://upload.wikimedia.org/wikipedia/commons/thumb/1/18/DSM-I_Cover.jpg/800px-DSM-I_Cover.jpg" },
              "text": {
                "headline": "Publicación del DSM-I",
                "text": "La APA publica la primera edición del Manual Diagnóstico y Estadístico de los Trastornos Mentales, otorgando a la disciplina un lenguaje estandarizado."
              },
              "group": "Consolidación"
            }
          ]
        };

        window.timeline = new TL.Timeline('timeline-embed', timelineData, {
            language: "es"
        });
    </script>
</body>
</html>
